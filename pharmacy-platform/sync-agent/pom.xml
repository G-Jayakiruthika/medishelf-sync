<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven build (optional: build.sh / build.bat need only a JDK). No dependencies: the agent uses the standard JDK only. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>in.aushadhbox</groupId>
  <artifactId>aushadhbox-sync</artifactId>
  <version>1.0.0</version>
  <name>AushadhBox Pharmacy sync agent</name>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <finalName>aushadhbox-sync</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration><archive><manifest><mainClass>in.aushadhbox.sync.SyncAgent</mainClass></manifest></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
