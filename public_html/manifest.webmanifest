{
  "name": "AushadhBox",
  "short_name": "AushadhBox",
  "description": "Family medicine cabinet: scan medicines, track expiry and get dose reminders in 10 Indian languages.",
  "start_url": "/app#cabinet",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EEF2EF",
  "theme_color": "#1F3358",
  "lang": "en-IN",
  "share_target": {
    "action": "/app/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "files": [{ "name": "photo", "accept": ["image/*"] }] }
  },
  "shortcuts": [
    { "name": "Emergency card", "short_name": "Emergency", "url": "/app#emergency", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today's doses", "short_name": "Doses", "url": "/app#doses", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tick doses (watch)", "short_name": "Tick", "url": "/watch", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan a medicine", "short_name": "Scan", "url": "/app#scan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
